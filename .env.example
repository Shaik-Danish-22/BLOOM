# BLOOM Environment Configuration Template
# 
# Copy this file to .env.local and fill in your API keys
# SECURITY WARNING: .env.local is gitignored - never commit real keys!
# 
# See docs/SETUP_GUIDE.md for detailed configuration instructions

# ═══════════════════════════════════════════════════════════════
# Google Genkit Configuration
# ═══════════════════════════════════════════════════════════════
# Get key from: https://console.cloud.google.com/
# - Enable "Generative Language API"
# - Create API key under Credentials
NEXT_PUBLIC_GOOGLE_GENAI_API_KEY=your_google_genai_api_key_here

# ═══════════════════════════════════════════════════════════════
# Firebase Configuration
# ═══════════════════════════════════════════════════════════════
# Get config from: https://console.firebase.google.com/
# - Project Settings → Your Apps → Web App
# - Copy config values below

# Firebase API Key (public)
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key

# Firebase Auth Domain
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com

# Firebase Project ID
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id

# Firebase Storage Bucket
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com

# Firebase Messaging Sender ID
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=1234567890

# Firebase App ID
NEXT_PUBLIC_FIREBASE_APP_ID=1:1234567890:web:abcdef1234567890

# ═══════════════════════════════════════════════════════════════
# DeepSeek Reasoning (via OpenRouter)
# ═══════════════════════════════════════════════════════════════
# Get key from: https://openrouter.ai/
# - Sign up or log in
# - Go to Keys → Create new API key
# - Fund account with payment method

# OpenRouter API Key (private - DO NOT expose)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Model specification
# Options: deepseek/deepseek-r1 (default)
OPENROUTER_MODEL=deepseek/deepseek-r1

# ═══════════════════════════════════════════════════════════════
# Fallback Provider Configuration (Optional)
# ═══════════════════════════════════════════════════════════════
# If DeepSeek is unavailable, BLOOM falls back to Gemini
# Configure additional fallbacks here if desired

# Fallback AI Model
# Default: googleai/gemini-2.5-flash
# Options:
#   - googleai/gemini-2.5-flash
#   - anthropic/claude-3-sonnet
#   - meta-llama/llama-2-70b
FALLBACK_AI_MODEL=googleai/gemini-2.5-flash

# ═══════════════════════════════════════════════════════════════
# Development Configuration (Optional)
# ═══════════════════════════════════════════════════════════════

# Enable Next.js debug mode
# NEXT_DEBUG=false

# Log level for AI operations
# Options: error, warn, info, debug
# LOG_LEVEL=info

# Cache configuration
# CACHE_ENABLED=true
# CACHE_TTL_SECONDS=86400

# ═══════════════════════════════════════════════════════════════
# Performance & Scaling (Optional, Production)
# ═══════════════════════════════════════════════════════════════

# Request timeout for AI providers (milliseconds)
# AI_REQUEST_TIMEOUT=45000

# Maximum retries for failed requests
# AI_MAX_RETRIES=3

# Enable provider response caching
# ENABLE_RESPONSE_CACHE=true

# Database connection pool size
# DB_POOL_SIZE=10

# ═══════════════════════════════════════════════════════════════
# Feature Flags (Optional)
# ═══════════════════════════════════════════════════════════════

# Enable experimental features
# EXPERIMENTAL_FEATURES=false

# Enable investor interview simulation (beta)
# ENABLE_INVESTOR_SIMULATION=true

# Enable workspace collaboration (beta)
# ENABLE_COLLABORATION=false

# ═══════════════════════════════════════════════════════════════
# Monitoring & Analytics (Optional)
# ═══════════════════════════════════════════════════════════════

# Sentry error tracking (optional)
# SENTRY_DSN=

# Analytics tracking (optional)
# ANALYTICS_ENABLED=true
# ANALYTICS_KEY=

# ═══════════════════════════════════════════════════════════════
# END OF CONFIGURATION
# ═══════════════════════════════════════════════════════════════
